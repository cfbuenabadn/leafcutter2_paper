# Ignore everything by default; only the workflow source is tracked.
*

# --- Workflow source ---
!config/
!config/**
!envs/
!envs/**
!rules/
!rules/**
!scripts/
!scripts/**
!module_workflows/
!module_workflows/**
!snakemake_profiles/
!snakemake_profiles/**
!.test/
!.test/**
# resources/ is a data dump; only these two small reference files are tracked
!resources/
!resources/all_genes.protein_coding.bed.gz
!resources/hg38_w_chrEBV.chrom.sizes

!Snakefile
!samples.tsv
!README.md
!LICENSE

# --- Repo metadata ---
!.gitignore
!.gitattributes
!.editorconfig

# --- Junk that stays ignored even inside the directories above ---
**/.ipynb_checkpoints/
**/__pycache__/
*.pyc
*.ipynb
*.swp
.snakemake*
